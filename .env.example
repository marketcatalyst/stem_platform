# ==============================================================================
# STEM Platform Environment Configuration Template
# ==============================================================================

# System Mode
STEM_ENV=development

# Database Connectivity (PostgreSQL / Neon)
# Root / administrative database connection string
DATABASE_URL=postgresql://user:password@localhost:5432/stem_master?sslmode=require

# Multi-Tenant Bridge Isolation Parameters
DB_POOL_MIN_CONNECTIONS=1
DB_POOL_MAX_CONNECTIONS=20

# AI Orchestration Node
GEMINI_API_KEY=your_gemini_api_key_here

# Operational Performance Constraints
MANDATORY_LATENCY_THRESHOLD_MS=350

# Application Network Bindings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0